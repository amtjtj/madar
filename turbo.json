{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["PLAYWRIGHT_CHROMIUM_EXECUTABLE", "PLAYWRIGHT_BROWSERS_PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL", "NEXT_PUBLIC_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "APP_DATABASE_URL",
        "WORKER_DATABASE_URL",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "PUSH_PROXY_URL",
        "REDIS_URL",
        "AUTH_*",
        "TENANT_SIGNUP_CODE",
        "SEED_PASSWORD",
        "API_PORT",
        "WEB_PORT",
        "API_INTERNAL_URL",
        "API_CORS_ORIGINS",
        "AI_SERVICE_URL",
        "AI_SERVICE_TOKEN",
        "AI_TIMEOUT_MS",
        "AI_ASK_MAX_DISTANCE"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "APP_DATABASE_URL",
        "WORKER_DATABASE_URL",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "PUSH_PROXY_URL",
        "REDIS_URL",
        "AUTH_*",
        "TENANT_SIGNUP_CODE"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "APP_DATABASE_URL",
        "WORKER_DATABASE_URL",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "PUSH_PROXY_URL",
        "REDIS_URL",
        "AUTH_*",
        "TENANT_SIGNUP_CODE",
        "API_PORT",
        "WEB_PORT",
        "E2E_*",
        "API_INTERNAL_URL"
      ]
    }
  }
}
