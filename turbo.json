{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["PLAYWRIGHT_CHROMIUM_EXECUTABLE", "PLAYWRIGHT_BROWSERS_PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL", "NEXT_PUBLIC_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "APP_DATABASE_URL",
        "REDIS_URL",
        "AUTH_*",
        "TENANT_SIGNUP_CODE",
        "SEED_PASSWORD",
        "API_PORT",
        "WEB_PORT",
        "API_INTERNAL_URL",
        "API_CORS_ORIGINS"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "APP_DATABASE_URL", "REDIS_URL", "AUTH_*", "TENANT_SIGNUP_CODE"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "APP_DATABASE_URL",
        "REDIS_URL",
        "AUTH_*",
        "TENANT_SIGNUP_CODE",
        "API_PORT",
        "WEB_PORT",
        "E2E_*",
        "API_INTERNAL_URL"
      ]
    }
  }
}
