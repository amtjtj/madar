# Copy to .env (git-ignored) and adjust. Every variable the apps read is listed here.

# --- PostgreSQL (docker/docker-compose.yml) ---
POSTGRES_USER=madar
POSTGRES_PASSWORD=madar_dev_password
POSTGRES_DB=madar
POSTGRES_PORT=5432
# Owner role: migrations and seed only
DATABASE_URL=postgres://madar:madar_dev_password@localhost:5432/madar
# Application role (API, workers, tests): never the owner, never bypasses RLS. Created by db:migrate.
APP_DATABASE_URL=postgres://madar_app:madar_app_dev_password@localhost:5432/madar
# Worker role (ADR 0011): only it may read the outbox across tenants.
WORKER_DATABASE_URL=postgres://madar_worker:madar_worker_dev_password@localhost:5432/madar

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---
API_PORT=4000
# Comma-separated origins allowed to call the API directly (empty = same-origin only via proxy)
API_CORS_ORIGINS=

# --- Auth (Better Auth, in the API) ---
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Public origin the browser uses (the web app, which proxies /api)
AUTH_BASE_URL=http://localhost:3000
# Extra allowed origins, comma-separated (optional)
AUTH_TRUSTED_ORIGINS=
# Required to register a company in production; leave empty for open signup in development
TENANT_SIGNUP_CODE=
# --- Device notifications (Web Push) ---
# Our own VAPID key pair; empty = device notifications off. Generate once with
# `pnpm --filter @madar/api vapid:generate` (after a build) and keep them: new keys drop every device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact sent to push services (mailto: or https:); empty = mailto:support@<AUTH_BASE_URL host>
VAPID_SUBJECT=
# Optional outbound proxy for reaching the browsers' push services
PUSH_PROXY_URL=

# Attachments (ADR 0019): local disk (default; .data/files in development) or an S3-compatible
# service such as an Iranian cloud storage or MinIO.
STORAGE_DRIVER=local
STORAGE_DIR=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Most Iranian S3 services and MinIO want path-style addresses.
S3_FORCE_PATH_STYLE=true
# Demo server only (plan phase-1-step-9): allows seeding and nightly reset of the demo company
DEMO_MODE=
# Password for every seeded demo account
SEED_PASSWORD=madar-demo-1234

# --- Assistant (apps/ai, ADR 0025) ---
# Empty: the assistant is not installed. For development with the fake model:
#   AI_SERVICE_URL=http://localhost:4200 and run `pnpm --filter @madar/ai dev:ai`
AI_SERVICE_URL=
# Shared secret between the API and the AI service (both read it)
AI_SERVICE_TOKEN=change-me-ai-token-0123456789
# `fake` answers without a model; `openai` talks to vLLM or llama.cpp at LLM_BASE_URL
LLM_PROVIDER=fake
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen2.5-7b-instruct
# Embeddings for «از مدار بپرس» (ADR 0026): `fake` (follows LLM_PROVIDER when unset) or `openai`
# (llama.cpp with --embeddings and bge-m3 at EMBED_BASE_URL)
EMBED_PROVIDER=fake
EMBED_BASE_URL=http://localhost:8081/v1
EMBED_MODEL=bge-m3
# Cosine distance above which a chunk is unrelated to a question: 0.6 for bge-m3, 0.95 for `fake`
AI_ASK_MAX_DISTANCE=0.95

# --- Web (apps/web) ---
WEB_PORT=3000
# Where the Next.js server forwards /api/* (dev proxy; Caddy does this in production)
API_INTERNAL_URL=http://localhost:4000

# --- Tests ---
# Optional: use a preinstalled Chromium instead of downloading Playwright's browser
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# --- Privacy: no telemetry calls to foreign services ---
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
