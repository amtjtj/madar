# Madar production settings: a template of what scripts/deploy/init-env.sh writes to .env on the
# server (docs/deploy.md). Prefer running init-env.sh: it makes every password random. If you write
# .env by hand, replace every <...> value; the API refuses to start with weak or example values.
# Never commit the real .env. Keep a copy outside the server: backups are useless without it.
# Read by docker/compose.prod.yml (docker compose --env-file .env ...), never by the browser.

# --- Domain and HTTPS (Caddy) ---
# The public domain; its DNS A record must point at this server. The app is https://<MADAR_DOMAIN>.
MADAR_DOMAIN=app.example.ir
# Caddy global options: the email for certificate notices (Let's Encrypt / ZeroSSL).
CADDY_GLOBAL_OPTIONS=email admin@example.ir
# Empty = automatic certificate. Own certificate: tls /certs/fullchain.pem /certs/privkey.pem
# (files in docker/caddy/certs/). Local test without a public domain: tls internal
CADDY_TLS=

# --- Image and package mirrors (builds on the server) ---
# Where base images come from; a domestic Docker mirror if Docker Hub is blocked, e.g.
# <your-provider-mirror>/library (ask the provider for its address).
BASE_REGISTRY=docker.io/library
# npm registry for building the images; a domestic npm mirror if registry.npmjs.org is blocked.
NPM_REGISTRY=https://registry.npmjs.org/

# --- PostgreSQL (container "postgres", never published to the internet) ---
# Owner role: creates the schema, runs migrations, owns backups. Random, URL-safe (letters/digits).
POSTGRES_USER=madar_owner
POSTGRES_PASSWORD=<random-32-chars>
POSTGRES_DB=madar
# Same owner, as a URL (used only by the migrate job and the demo seed).
DATABASE_URL=postgres://madar_owner:<same-as-POSTGRES_PASSWORD>@postgres:5432/madar
# App role used by the API: Row-Level Security applies. The migrate job creates the role with this
# password, so choose it here (random, different from the owner's).
APP_DATABASE_URL=postgres://madar_app:<random-32-chars>@postgres:5432/madar
# Worker role (outbox relay across companies); created by the migrate job with this password.
WORKER_DATABASE_URL=postgres://madar_worker:<random-32-chars>@postgres:5432/madar

# --- Sign-in (Better Auth, in the API) ---
# Signs sessions and encrypts two-factor secrets. At least 32 random characters; changing it signs
# everyone out and breaks existing two-factor setups.
AUTH_SECRET=<random-48-chars>
# Code needed to register a new company through the app (at least 12 characters). Give it only to
# the people who should create a company.
TENANT_SIGNUP_CODE=<random-20-chars>
# Extra origins allowed to call the sign-in endpoints (comma-separated); usually empty.
AUTH_TRUSTED_ORIGINS=
# Companies (slugs) whose admins may sign in without two-factor: only a presentation company such
# as the seeded zarrin-madar (docs/deploy.md). Leave empty for real companies.
TWO_FACTOR_OPTIONAL_TENANTS=

# --- Device notifications (Web Push) ---
# Filled in once by the first scripts/deploy/deploy.sh. Never change them afterwards: every device
# would have to turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact sent to browsers' push services.
VAPID_SUBJECT=mailto:admin@example.ir
# Outbound proxy for push services abroad, if the server cannot reach them; empty = direct.
PUSH_PROXY_URL=

# --- Attachments (ADR 0019) ---
# local = the files-data Docker volume on this server (/data/files inside the containers);
# s3 = an S3-compatible service (then fill the S3_* values; the bucket must be private).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Most Iranian S3 services and MinIO want path-style addresses.
S3_FORCE_PATH_STYLE=true

# --- Backups (container "backup"; files in ./backups, readable by root only) ---
# Nightly backup time, Tehran time (HH:MM), and how many daily / weekly copies to keep.
BACKUP_AT=03:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Optional copy of every backup to an S3-compatible bucket outside the server (recommended).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- Assistant (optional, ADR 0025/0026; off unless set up, docs/deploy.md, appendix «ه») ---
# Empty = not installed. With a model: COMPOSE_PROFILES=ai,llm-cpu and AI_SERVICE_URL=http://ai:4200
AI_SERVICE_URL=
# Shared secret between the API and the AI service (random, at least 16 characters).
AI_SERVICE_TOKEN=<random-32-chars>
# Model names and files in ./models (see docs/deploy.md, appendix «ه»).
LLM_MODEL=qwen2.5-7b-instruct
LLM_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
LLM_THREADS=4
EMBED_MODEL=bge-m3
EMBED_MODEL_FILE=bge-m3-Q8_0.gguf
EMBED_THREADS=2
# How close a text must be to a question for «از مدار بپرس» (0.6 suits bge-m3).
AI_ASK_MAX_DISTANCE=0.6

# --- Optional services (Docker Compose profiles) ---
# Comma-separated: demo (demo company with nightly reset), ai, llm-cpu or llm-gpu. Empty for a
# normal company server.
COMPOSE_PROFILES=

# --- Demo server only (init-env.sh --demo); leave out on a real company server ---
# DEMO_MODE=true
# DEMO_PASSWORD=<random-12-chars>     # password of every demo account
# DEMO_RESET_AT=05:00                 # nightly reset, Tehran time
